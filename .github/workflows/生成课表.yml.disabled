name: 生成课表

# Status: demo-ready
# 说明：这是公开展示版中最接近真实运行链路的 workflow。
# 它展示了双仓库 checkout、脚本执行与 Markdown 产物生成的基本结构。
# 其中仓库名与 token 均为占位示例，不代表真实私有环境配置。

on:
  schedule:
    - cron: "0 22 * * *"
  repository_dispatch:
    types: [content-push]
  workflow_dispatch:

concurrency:
  group: showcase-main-write
  cancel-in-progress: true

permissions:
  contents: write

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - name: 拉取内容层仓库
        uses: actions/checkout@v4
        with:
          repository: your-org/content-showcase-repo
          token: ${{ secrets.CONTENT_PUSH_TOKEN }}

      - name: 拉取执行层仓库
        uses: actions/checkout@v4
        with:
          repository: your-org/engine-showcase-repo
          path: _engine
          token: ${{ secrets.CONTENT_PUSH_TOKEN }}

      - name: 安装 Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: 生成课表样例
        run: |
          node _engine/scripts/generate-timetable.js \
            _engine/data/schedule.sample.json \
            _engine/data/adjustments.sample.json \
            09-日常处理/课表-样例.md

      - name: 推送更新后的样例产物
        run: |
          echo "展示版示例：此处可以提交或保存自动生成的 Markdown 产物"